{
  "name": "taqyeem",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migration:create": "wrangler d1 migrations create DB",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrations:list:remote": "wrangler d1 migrations list DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:list": "wrangler d1 migrations list DB --local",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "test:d1": "node test/d1-smoke.ts",
    "test": "NODE_ENV=test remix test",
    "types:worker": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "remix": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "latest",
    "typescript": "latest",
    "vite": "^8",
    "wrangler": "^4.152.0"
  }
}
